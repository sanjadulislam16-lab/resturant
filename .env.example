# Supabase PostgreSQL transaction-pooler connection URI (port 6543); server-side only.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Required in Netlify production; generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret"

# Required for the initial production seed; use a private admin account/password.
BOOTSTRAP_ADMIN_EMAIL="you@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"

# Optional, only when the app's Gemini feature is configured.
GEMINI_API_KEY=""
APP_URL="https://your-site.netlify.app"
